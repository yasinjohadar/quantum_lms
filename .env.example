APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Remember-me and preferred dial-code cookies (minutes). Default: 5 years.
AUTH_REMEMBER_MINUTES=2628000
AUTH_PREFERRED_COUNTRY_MINUTES=2628000

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# false = إيقاف Echo/WebSocket في المتصفح (لا محاولات اتصال متكررة؛ تحديث العدد دورياً فقط)
ECHO_NOTIFICATIONS_ENABLED=true

# بث الأحداث من PHP (إرسال اختبار، تحفيز، إلخ). على الإنتاج بدون Reverb شغّال:
# BROADCAST_CONNECTION=null
# ثم: php artisan config:clear
# أو شغّل Reverb محلياً وعيّن REVERB_BROADCAST_* أدناه (127.0.0.1:8080)
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=quantum-lms
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# اختياري: عنوان اتصال PHP بـ Reverb على نفس السيرفر (يمنع cURL timeout للدومين/منفذ خاطئ)
# REVERB_BROADCAST_HOST=127.0.0.1
# REVERB_BROADCAST_PORT=8080
# REVERB_BROADCAST_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ملاحظة: يُحقَن تلقائياً من config/echo-client.php إلى الصفحة (window.__echoReverbConfig)
# حتى تعمل تعديلات السيرفر بعد php artisan config:clear دون إعادة build فقط لعنوان WebSocket
