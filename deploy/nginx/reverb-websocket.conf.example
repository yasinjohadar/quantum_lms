# Nginx — WebSocket proxy لـ Laravel Reverb
# أضف داخل server block الخاص بالدومين (مثال: quantum-academy.online)
#
# في .env للإنتاج:
#   ECHO_NOTIFICATIONS_ENABLED=true
#   BROADCAST_CONNECTION=reverb
#   REVERB_HOST=quantum-academy.online
#   REVERB_PORT=443
#   REVERB_SCHEME=https
#   REVERB_BROADCAST_HOST=127.0.0.1
#   REVERB_BROADCAST_PORT=8080
#   REVERB_BROADCAST_SCHEME=http
#   VITE_REVERB_HOST="${REVERB_HOST}"
#   VITE_REVERB_PORT="${REVERB_PORT}"
#   VITE_REVERB_SCHEME="${REVERB_SCHEME}"
#
# ثم: php artisan config:clear && npm run build

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

location /app {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Scheme $scheme;
    proxy_set_header SERVER_PORT $server_port;
    proxy_set_header SERVER_NAME $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 86400;
}
